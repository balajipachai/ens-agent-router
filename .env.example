# ENS name whose `app.agent-router.agents` text record lists the helpers' ENS names.
DIRECTORY_NAME=

# OpenAI-compatible chat completions API (any provider).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_MS=20000

# Timeout for the call forwarded to the chosen helper.
AGENT_TIMEOUT_MS=15000
# How long discovered agents are cached before ENS is re-read.
AGENTS_TTL_MS=60000

# Optional: your own Sepolia RPC. Falls back to viem's default public endpoint.
SEPOLIA_RPC_URL=

# Development only: allow http://localhost endpoints (otherwise https is required).
ALLOW_LOCALHOST_ENDPOINTS=false
PORT=3000

# Only for `npm run set-agent` (Sepolia testnet key that owns the ENS name).
# PRIVATE_KEY=
